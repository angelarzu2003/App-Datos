<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Acceso a datos de uso: lo concede el usuario en Ajustes. Permite leer el consumo por app. -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <!-- Solo para saber si la red activa es móvil o Wi-Fi. NO da acceso a internet. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Para mostrar el nombre de cada app (uso personal, no se publica en tienda). -->
    <uses-permission
        android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <!--
        A PROPÓSITO NO SE DECLARA android.permission.INTERNET.
        La app no puede enviar nada fuera del teléfono. Ver docs/06 (ADR-03).
    -->

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.DatoReal">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.DatoReal">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
